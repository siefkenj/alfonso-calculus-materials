#question(title: [The norm of a partition])[
  #set text(size: 13pt)

  + Construct a partition $P$ of $[0, 1]$
    such that $display(norm(P) = pi/10)$.
  + Construct a sequence of partitions of
    $[0, 1]$
     $
       P_1 , P_2 , P_3 , ...
     $
     #emph[as simple as possible], such that
     $display(lim_(n -> oo) norm(P_n) = 0)$.
  + Construct a #emph[different] sequence of
    partitions of $[0, 1$\]
     $
       Q_1 , Q_2 , Q_3 , ...
     $
     such that
     $display(lim_(n -> oo) norm(Q_n) = 0)$.
]
