#question(title: [True or False - Suprema and infima], shrink: true)[
  #set text(size: 12pt)

  Let $A, B, C subset.eq RR$. Assume
  $C subset.eq A$. Which statements are true?
  #v(0.1cm)

  If possible, fix the false statements
  #v(0.2cm)

  + IF #h(.25em)$A$ is bounded above,
    #h(.25em) THEN #h(.25em)$C$ is bounded
    above.
  + IF #h(.25em)$C$ is bounded below,
    #h(.25em) THEN #h(.25em)$A$ is bounded
    below.
     #v(0.2cm)
  + IF #h(.25em)$A$ and $C$ are bounded
    above, #h(.25em) THEN
    #h(.25em)$sup C <= sup A$.
  + IF #h(.25em)$A$ and $C$ are bounded
    below, #h(.25em) THEN
    #h(.25em)$inf C <= inf A$.
     #v(0.2cm)
  + IF #h(.25em)$A$ and $B$ are bounded,
    #h(.25em)$sup B <= sup A$, #h(.25em)and
    #h(.25em)$inf A <= inf B$,
     #v(0.1cm)

     THEN #h(.25em)$B subset.eq A$.
     #v(0.2cm)
  + IF #h(.25em)$A$ and $B$ are bounded
    above,
     #v(0.1cm)

     THEN
     #h(.25em)$display(sup(A union B) = max {sup A comma sup B})$.
  + IF #h(.25em)$A$ and $B$ are bounded
    above,
     #v(0.1cm)

     THEN
     #h(.25em)$display(sup(A inter B) = min {sup A comma sup B})$.
]
