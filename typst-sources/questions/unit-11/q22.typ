#question(title: [Refining the Big Theorem - 1])[
  + Construct a sequence $display({u_n}_n)$
    such that
     $
       cases(forall a < 0 comma & quad n^a << u_n, forall a >= 0 comma & quad u_n << n^a)
     $
  + Construct a sequence $display({v_n}_n)$
    such that
     $
       cases(forall a <= 0 comma & quad n^a << v_n, forall a > 0 comma & quad v_n << n^a)
     $
]
