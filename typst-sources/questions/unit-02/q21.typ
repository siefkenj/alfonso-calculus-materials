#question(title: [Preparation: choosing deltas])[
  + Find one value of $delta > 0$ such that
     $
       abs(x - 3) < delta ==> abs(5 x - 15) < 1 .
     $
  + Find #emph[all] values of $delta > 0$
    such that
     $
       abs(x - 3) < delta ==> abs(5 x - 15) < 1 .
     $
  + Find #emph[all] values of $delta > 0$
    such that
     $
       abs(x - 3) < delta ==> abs(5 x - 15) < 0.1 .
     $
  + Let us fix $epsilon > 0$. Find #emph[all]
    values of $delta > 0$ such that
     $
       abs(x - 3) < delta ==> abs(5 x - 15) < epsilon .
     $
]
