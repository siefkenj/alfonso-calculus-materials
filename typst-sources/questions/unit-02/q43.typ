#question(title: [True or False? -- Discontinuities], centered: true)[
  + IF $f$ and $g$ have removable
    discontinuities at $a$

     THEN $f + g$ has a removable
     discontinuity at $a$
  + IF $f$ and $g$ have non-removable
    discontinuities at $a$

     THEN $f + g$ has a non-removable
     discontinuity at $a$
]
