#question(title: [True or False?], centered: true)[
  #v(1fr)

  Is this theorem true?

  #v(1fr)

  #slide-block(title: [Claim])[
    Let $a in RR$.  \
    Let $f$ and $g$ be functions defined near
    $a$.  \

    - IF $display(lim_(x -> a) f(x) = 0)$,
    - THEN
      $display(lim_(x -> a) [f(x) g(x)] = 0)$.
  ]

  #v(1fr)
]
