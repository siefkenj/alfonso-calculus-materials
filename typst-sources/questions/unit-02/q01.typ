#question(title: [Properties of inequalities], centered: true)[
  Let $a, b, c in RR$.  \
  Assume $a < b$. What can we conclude?

  #grid(
    columns: 2,
    column-gutter: 1em,
    [
      + $display(a + c < b + c)$
      + $display(a - c < b - c)$
      + $display(a c < b c)$
    ],
    [
      4. $display(a^2 < b^2)$
      + $display(1/a < 1/b)$
    ],
  )

  If any of the conclusions is wrong, fix it.
]
