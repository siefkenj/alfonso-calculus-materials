#question(title: [Limits at infinity], centered: true)[
  Compute:

  #grid(
    columns: 2,
    column-gutter: 1em,
    [
      + $display(lim_(x -> oo) (x^7 - 2 x^5 + 11))$
      + $display(lim_(x -> oo) (x^2 - sqrt(x^5 + 1)))$
      + $display(lim_(x -> oo) (x^2 + 11)/(x + 1))$
    ],
    [
      4. $display(lim_(x -> oo) (x^2 + 2 x + 3)/(3 x^2 + 4 x + 5))$
      + $display(lim_(x -> oo) (x^3 + sqrt(2 x^6 + 1))/(2 x^3 + sqrt(x^5 + 1)))$
    ],
  )
]
