#question(title: [Infinite limits], centered: true)[
  #slide-block(title: [Definition])[
    Let $a in RR$.  \
    Let $f$ be a function defined at least on
    an interval around $a$, except possibly
    at $a$.  \
    Write a formal definition for
    $
      lim_(x -> a) f(x) = oo .
    $
  ]
]
