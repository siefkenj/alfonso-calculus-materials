#question(title: [Undefined function])[
  #set text(size: 13pt)
  Let $a in RR$ and let $f$ be a function.
  Assume $f(a)$ is undefined.

  #v(1fr)

  #slide-block(title: [What can we conclude?])[
    + $display(lim_(x -> a) f(x))$ exist
    + $display(lim_(x -> a) f(x))$ doesn't
      exist.
    + No conclusion.
      $display(lim_(x -> a) f(x))$ may or may
      not exist.
  ]

  #v(1fr)

  #slide-block(title: [What else can we conclude?])[
    4. $f$ is continuous at $a$.
    + $f$ is not continuous at $a$.
    + No conclusion. $f$ may or may not be
      continuous at $a$.
  ]

  #v(1fr)
]
