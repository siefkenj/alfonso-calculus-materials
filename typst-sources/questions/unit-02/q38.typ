#question(title: [Limits involving $display(sin(1 \/ x))$ Part
II], centered: true)[
  #slide-block(title: [The limit $display(lim_(x -> 0) x^2 sin(1 \/ x))$])[
    + does not exist because the function
      values oscillate around $0$
    + does not exist because $1 \/ 0$ is
      undefined
    + does not exist because no matter how
      close $x$ gets to $0$, there are $x$'s
      near $0$ for which $sin(1 \/ x) = 1$,
      and some for which $sin(1 \/ x) = - 1$
    + equals 0
    + equals 1
  ]
]
