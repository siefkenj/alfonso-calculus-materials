#question(title: [Recall the definitions])[
  #set enum(spacing: .55em + 0.15cm)
  + #strong[Type-1 improper integrals.] Let
    $f$ be a bounded, continuous function on
    $display([c comma oo))$. How do we define
    the improper integral
     $
       integral_c^oo f(x) d x thin ?
     $
  + #strong[Type-2 improper integrals.] Let
    $f$ be a continuous function on
    $display((a comma b])$, possibly with
    $x = a$ as a vertical asymptote. How do
    we define the improper integral
    $
      integral_a^b f(x) d x thin ?
    $

  #v(1fr)
]
