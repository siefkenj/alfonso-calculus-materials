#question(title: [Minimizing area])[
  For each $a > 0$ consider the function
  $
    f_a (x) = 1 + a - a x^2
  $

  Find the value of $a$ that minimizes the
  area of the region bounded by the graph of
  $f_a$ and the $x$-axis. #h(1fr)
  #link("https://www.desmos.com/calculator/x7vkfcerdp")[#goto-button[desmos]]
]
