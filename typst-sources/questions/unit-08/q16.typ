#question(title: [Examples of FTC-1])[
  #set text(size: 13pt)

  Compute the derivative of the following
  functions

  #set enum(spacing: .55em - 0.05cm)
  + $display(F_1 (x) = integral_0^1 e^(-t^2) d t)$.
  + $display(F_2 (x) = integral_0^x e^(-sin t) d t)$.
  + $display(F_3 (x) = integral_1^(x^2) (sin t)/(t^2) d t)$.
  + $display(F_4 (x) = integral_x^7 sin^3 (sqrt(t)) d t)$.
  + $display(F_5 (x) = integral_(2 x)^(x^2) 1/(1 + t^3) d t)$.
]
