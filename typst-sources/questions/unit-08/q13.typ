#question(title: [True or False?])[
  #set text(size: 13pt)

  + If $f$ is continuous on the interval
    $[a, b]$, then
     $
       d/(d x) (integral_a^b f(t) d t) = f(x) .
     $

     #v(4mm)
  + If $f$ is differentiable, then
     $
       d/(d x) (integral_a^x f(t) thin d t) thick = thick integral_a^x f' (t) thin d t .
     $
]
