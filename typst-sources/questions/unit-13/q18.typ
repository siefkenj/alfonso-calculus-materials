#question(title: [True or False -- Harder questions], shrink: true)[
  #set text(size: 12pt)

  + IF $display(sum_(n = 0)^oo a_n)$ is
    convergent, #h(1em) THEN
    $display(lim_(k -> oo) [sum_(n = k)^oo a_n] = 0)$.
  + IF
    $display(lim_(k -> oo) [sum_(n = k)^oo a_n] = 0)$,
    #h(1em) THEN
    $display(sum_(n = 0)^oo a_n)$ is
    convergent.
  + IF $display(sum_(n = 1)^oo a_(2 n))$ and
    $display(sum_(n = 1)^oo a_(2 n + 1))$ are
    convergent,

     THEN $display(sum_(n = 1)^oo a_n)$ is
     convergent.
  + IF $display(sum_(n = 1)^oo a_n)$ is
    convergent,

     THEN $display(sum_(n = 1)^oo a_(2 n))$
     and
     $display(sum_(n = 1)^oo a_(2 n + 1))$
     are convergent.
]
