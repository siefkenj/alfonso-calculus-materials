#question(title: [True or False -- The Necessary Condition])[
  #set enum(spacing: .55em + 0.3cm)
  + IF $display(lim_(n -> oo) a_n = 0)$,
    #h(1em) THEN $display(sum_n^oo a_n)$ is
    convergent.
  + IF $display(lim_(n -> oo) a_n != 0)$,
    #h(1em) THEN $display(sum_n^oo a_n)$ is
    divergent.
  + IF $display(sum_n^oo a_n)$ is convergent
    #h(1em) THEN
    $display(lim_(n -> oo) a_n = 0)$.
  + IF $display(sum_n^oo a_n)$ is divergent
    #h(1em) THEN
    $display(lim_(n -> oo) a_n != 0)$.

  #v(1fr)
]
