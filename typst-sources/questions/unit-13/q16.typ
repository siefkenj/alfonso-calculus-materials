#question(title: [True or False -- The tail of a series], shrink: true)[
  #set text(size: 12pt)

  + IF the series
    #text(fill: blue)[$display(sum_(n = 0)^oo a_n)$]
    converges,

     THEN the series
     #text(fill: red)[$display(sum_(n = 7)^oo a_n)$]
     converges
  + IF the series
    #text(fill: red)[$display(sum_(n = 7)^oo a_n)$]
    converges,

     THEN the series
     #text(fill: blue)[$display(sum_(n = 0)^oo a_n)$]
     converges
  + IF the series
    #text(fill: red)[$display(sum_(n = 0)^oo a_n)$]
    converges,

     THEN the series
     #text(fill: blue)[$display(sum_(n = 7)^oo a_n)$]
     converges to a smaller number.
]
