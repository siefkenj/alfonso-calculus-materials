#question(title: [Absolute value and inverses])[
  Let
  $
    h(x) = x abs(x) + 1
  $

  + Calculate $display(h^(-1) (- 8))$.
  + Sketch the graph of $h$.
  + Find an equation for $display(h^(-1))$.
  + Sketch the graph of $display(h^(-1))$.
  + Verify that
     #[
       #set text(size: 14pt)
       - for every
         $display(t in #boxed[$display(? ? ?)$])$,
         #h(.25em)
         $display(h(h^(-1) (t)) = t)$.
       - for every
         $display(t in #boxed[$display(? ? ?)$])$,
         #h(.25em)
         $display(h^(-1) (h(t)) = t)$.
     ]
]
