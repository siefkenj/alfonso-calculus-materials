#question(title: [Composition of one-to-one functions -- 3])[
  Assume for simplicity that all functions in
  this problem have domain $RR$.

  #v(1fr)

  Prove the following claim is FALSE with a
  counterexample.

  #v(1fr)

  #slide-block(title: [Claim])[
    Let $f$ and $g$ be functions.  \
    IF $f circle.small g$ is one-to-one,  \
    THEN $f$ is one-to-one.
  ]

  #v(1fr)
]
