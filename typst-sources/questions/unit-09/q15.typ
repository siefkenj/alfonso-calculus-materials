#question(title: [Repeated factors])[
  #set text(size: 13pt)

  + Calculate
    $display(integral 1/((x + 1)^n) thin d x)$
    #h(1em) for $n > 1$
  + Calculate
    $display(integral ((x + 1) - 1)/((x + 1)^2) thin d x)$
  + Calculate
    $display(integral (2 x + 6)/((x + 1)^2) thin d x)$
  + Calculate
    $display(integral (x^2)/((x + 1)^3) thin d x)$
]
