#question(title: [Irreducible quadratics])[
  #set text(size: 13pt)

  + Calculate
    $display(integral 1/(x^2 + 1) thin d x)$
    and
    $display(integral x/(x^2 + 1) thin d x)$.
     #v(0.2cm)

     #emph[Hint:] These two are very short.
  + Calculate
    $display(integral (2 x + 3)/(x^2 + 1) thin d x)$
  + Calculate
    $display(integral (x^2)/(x^2 + 1) thin d x)$
  + Calculate
    $display(integral x/(x^2 + x + 1) thin d x)$
     #v(0.2cm)

     #emph[Hint:] Complete the square in the
     denominator and use a substitution to
     transform into one of the previous ones.
]
