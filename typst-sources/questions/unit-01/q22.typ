#question(title: [One-to-one functions], centered: true)[
  #strong[Definition:] Let $f$ be a function
  with domain $D$.  \
  $f$ is one-to-one means ...
  + $display(f(x_1) != f(x_2))$
  + $display(exists x_1 comma x_2 in D comma thick f(x_1) != f(x_2))$
  + $display(forall x_1 comma x_2 in D comma thick f(x_1) != f(x_2))$
  + $display(forall x_1 comma x_2 in D comma thick x_1 != x_2 comma thick f(x_1) != f(x_2))$
  + $display(forall x_1 comma x_2 in D comma thick x_1 != x_2 ==> f(x_1) != f(x_2))$
  + $display(forall x_1 comma x_2 in D comma thick f(x_1) != f(x_2) ==> x_1 != x_2)$
  + $display(forall x_1 comma x_2 in D comma thick f(x_1) = f(x_2) ==> x_1 = x_2)$
]
