#question(title: [Indecisive function], centered: true)[
  Construct a function $f$ that satisfies all
  of the following properties at once:
  - The domain of $f$ is $RR$.
  - $display(forall x in RR comma exists y in RR)$
    such that
    $
      x < y " and " f(x) < f(y)
    $
  - $display(forall x in RR comma exists y in RR)$
    such that
    $
      x < y " and " f(x) > f(y)
    $
]
