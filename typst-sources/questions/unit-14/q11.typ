#question(title: [True or False -- Operations with smooth functions])[
  Let $f$ and $g$ be two functions with
  domain $RR$. Let $n in NN$.
  #v(0.2cm)

  + IF $f$ and $g$ are $C^n$, #h(.25em) THEN
    $f + g$ is $C^n$.
  + IF $f$ and $g$ are $C^n$, #h(.25em) THEN
    $f dot.op g$ is $C^n$.
  + IF $f$ and $g$ are $C^n$, #h(.25em) THEN
    $f circle.small g$ is $C^n$.
  + IF $f$ and $g$ are $C^oo$, #h(.25em) THEN
    $f + g$ is $C^oo$.
  + IF $f$ and $g$ are $C^oo$, #h(.25em) THEN
    $f dot.op g$ is $C^oo$.
  + IF $f$ and $g$ are $C^oo$, #h(.25em) THEN
    $f circle.small g$ is $C^oo$.
]
