#question(title: [True or False -- smooth functions], shrink: true)[
  Let $f$ be a function. Let $a in RR$. Let
  $m in NN$.
  #v(0.2cm)

  + IF $f$ is continuous, #h(.25em) THEN $f$
    is $C^0$.
  + IF $f$ is $C^0$, #h(.25em) THEN $f$ is
    continuous.
  + IF $f$ is differentiable, #h(.25em) THEN
    $f$ is $C^1$.
  + IF $f$ is $C^1$, #h(.25em) THEN $f$ is
    differentiable.
  + IF $f$ is $C^oo$, #h(.25em) THEN
    $forall n in NN$, $f$ is $C^n$.
  + IF $forall n in NN$, $f$ is $C^n$,
    #h(.25em) THEN $f$ is $C^oo$.
  + IF $f$ is $C^m$ at $a$,  \
     #h(.25em) THEN $f$ is $C^m$ on some
     interval centered at $a$.
  + IF $f$ is $C^m$ at $a$,  \
     #h(.25em) THEN $f$ is $C^(m - 1)$ on
     some interval centered at $a$.
]
