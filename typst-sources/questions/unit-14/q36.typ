#question(title: [Limits])[
  Use Maclaurin series to compute these
  limits:
  #v(1fr)

  #set enum(spacing: .55em + 0.5cm)
  + #h(.25em)
    $display(lim_(x -> 0) (quad sin x - x + (x^3)/6 quad)/(x^5))$
  + #h(.25em)
    $display(lim_(x -> 0) (quad cos(2 x) - e^(-2 x^2) quad)/(x^4))$
  + #h(.25em)
    $display(lim_(x -> 0) ([sin x - x]^3 x)/(quad [cos x - 1]^4 [e^x - 1]^2) quad)$

  #v(1fr)
]
