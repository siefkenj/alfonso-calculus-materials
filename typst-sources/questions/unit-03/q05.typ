#question(title: [Estimations - 1], centered: true)[
  Let $f$ be a continuous function with
  domain $RR$.

  #v(1fr)

  #set enum(spacing: .55em + 0.1cm)
  + We know $f(4) = 3$ and $f(4.2) = 2.2$.  \
     Based only on this, give your best
     estimate for $f(4.1)$.
  + We know $f(4) = 3$ and $f' (4) = 0.6$.
     \
    Based only on this, give your best
    estimate for $f(4.1)$.
  + We know $f(4) = 3$ and $f(4.1) = 4$.  \
    Based only on this, give your best
    estimate for $f' (4)$.

  #v(1fr)
]
