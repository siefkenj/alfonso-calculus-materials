#question(title: [Absolute value and tangent lines])[
  At (0,0) the graph of
  $display(y = abs(x))$...
  + ... has one tangent line: $y = 0$
  + ... has one tangent line: $x = 0$
  + ... has two tangent lines $y = x$ and
    $y = - x$
  + ... has no tangent line

  #align(center)[#drawing(width: 49mm, function-graph(
    y: (-1.3, 5.3),
    graph-fn(calc.abs),
  ))]
]
