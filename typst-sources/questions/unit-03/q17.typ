#question(title: [True or False - Differentiability and Operations])[
  #set text(size: 13pt)

  Let $f$ be a function with domain $RR$. Let
  $c in RR$.  \
  Let $display(g(x) = f(x)^2)$. Which of
  these implications are true?

  #v(1fr)

  #set enum(spacing: .55em + 0.2cm)
  + IF $f$ is
    #text(fill: blue)[differentiable] at $c$,
    THEN $f + f'$ is
    #text(fill: red)[continuous] at $c$
  + IF $f$ is
    #text(fill: blue)[differentiable] at
    $c$, THEN $3 f$ is
    #text(fill: blue)[differentiable] at
    $c$.
  + IF $f$ is
    #text(fill: blue)[differentiable] at
    $c$, THEN $g$ is
    #text(fill: blue)[differentiable] at
    $c$.
  + IF $g$ is
    #text(fill: blue)[differentiable] at
    $c$, THEN $f$ is
    #text(fill: blue)[differentiable] at
    $c$.
  + IF $f$ is
    #text(fill: blue)[differentiable] at
    $c$, THEN $1 \/ f$ is
    #text(fill: blue)[differentiable] at
    $c$.

  #v(1fr)
]
