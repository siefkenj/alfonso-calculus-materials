#question(title: [True or False - Differentiability and Composition])[
  Let $f$ and $g$ be functions with domain
  $RR$. Let $c in RR$.  \
  Assume $f$ and $g$ are differentiable at
  $c$.  \
  What can we conclude?

  #v(1fr)

  #set enum(spacing: .55em + 0.45cm)
  + $f circle.small g$ #h(.25em) is
    #text(fill: blue)[differentiable] at $c$.
  + $f circle.small f$ #h(.25em) is
    #text(fill: blue)[differentiable] at
    $c$.
  + $f circle.small sin$ #h(.25em) is
    #text(fill: blue)[differentiable] at
    $c$.
  + $sin circle.small f$ #h(.25em) is
    #text(fill: blue)[differentiable] at
    $c$.

  #v(1fr)
]
