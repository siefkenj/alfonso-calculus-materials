#question(title: [True or False - Differentiability vs Continuity])[
  #set text(size: 13pt)

  Let $f$ be a function with domain $RR$. Let
  $c in RR$.  \
  Which of these implications are true?

  #v(1fr)

  #set enum(spacing: .55em + 0.15cm)
  + IF $f$ is #text(fill: red)[continuous] at
    $c$, THEN $f$ is
    #text(fill: blue)[differentiable] at $c$
  + IF $f$ is
    #text(fill: blue)[differentiable] at
    $c$, THEN $f$ is
    #text(fill: red)[continuous] at $c$
  + IF $f$ is
    #text(fill: blue)[differentiable] at
    $c$, THEN $f'$ is
    #text(fill: red)[continuous] at $c$
  + IF $f'$ is #text(fill: red)[continuous]
    at $c$, THEN $f$ is
    #text(fill: red)[continuous] at $c$
  + IF $f$ is
    #text(fill: blue)[differentiable] at
    $c$, THEN $f$ is
    #text(fill: red)[continuous] at and near
    $c$.
  + IF $f$ is #text(fill: red)[continuous]
    at and near $c$, THEN $f$ is
    #text(fill: blue)[differentiable] at
    $c$.

  #v(1fr)
]
