#question(title: [True or False -- Monotonicity and local extrema])[
  #set text(size: 13pt)

  Let $I$ be an interval. Let $f$ be a
  function defined on $I$. Let $c in I$.
  Which implications are true?

  + IF #text(fill: red)[$f$ is increasing on
    $I$], #h(1em) THEN
    #text(fill: blue)[$forall x in I$,
    $f' (x) > 0$].
  + IF #text(fill: blue)[$forall x in I$,
    $f' (x) > 0$], #h(1em) THEN
    #text(fill: red)[$f$ is increasing on
    $I$].
  + IF #text(fill: rosa)[$f$ has a local
    extremum at $c$], #h(1em) THEN
    #text(fill: naranja)[$f' (c) = 0$].
  + IF #text(fill: naranja)[$f' (c) = 0$],
    #h(1em) THEN #text(fill: rosa)[$f$
    has a local extremum at $c$].
  + IF #text(fill: rosa)[$f$ has local
    extremum at $c$], #h(.25em) THEN
    #text(fill: verde)[$f$ has an extremum at
    $c$]
  + IF #text(fill: verde)[$f$ has an extremum
    at $c$], #h(.25em) THEN
    #text(fill: rosa)[$f$ has local extremum
    at $c$]
]
