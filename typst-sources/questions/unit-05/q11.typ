#question(title: [A variant])[
  Complete this variation on Theorem 2.  \
  Use the weakest conditions you can to make
  it true.

  #slide-block(title: [Theorem 3])[
    Let $a < b$. Let $f$ be a function
    defined on $[a, b]$.  \
    IF
    - (Some conditions on continuity and
      differentiability)
    - $f$ is not one-to-one on $[a, b]$

    THEN $display(exists c in(a comma b))$
    such that $f' (c) = 0$.
  ]
]
