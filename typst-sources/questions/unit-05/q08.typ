#question(title: [The second Theorem of Rolle])[
  Complete statement for this theorem and
  prove it.

  #v(1fr)

  #slide-block(title: [Rolle's Theorem 2])[
    Let $a < b$. Let $f$ be a function
    defined on $[a, b]$.  \
    IF
    - (Some conditions on continuity and
      derivatives)
    - $display(f(a) = f' (a) = 0)$
    - $display(f(b) = 0)$

    THEN $display(exists c in(a comma b))$
    such that $display(f^(' ') (c) = 0)$.
  ]

  #v(1fr)

  #emph[Hint:] Apply the 1st Rolle's Theorem
  to $f$, then do something else.
]
