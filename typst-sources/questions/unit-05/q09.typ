#question(title: [The $N$-th Theorem of Rolle])[
  Complete the statement for this theorem and
  prove it.

  #slide-block(title: [Rolle's Theorem $N$])[
    Let $N$ be a positive integer.  \
    Let $a < b$. Let $f$ be a function
    defined on $[a, b]$.  \
    IF
    - (Some conditions on continuity and
      derivatives)
    - (Some conditions at $a$)
    - $display(f(b) = 0)$

    THEN $display(exists c in(a comma b))$
    such that $display(f^((N)) (c) = 0)$.
  ]
]
